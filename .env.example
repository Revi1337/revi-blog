SITE_URL=https://blog.revi1337.com

# Upstash Redis (Vercel Marketplace 연동 시 자동 생성 — vercel env pull .env.local 로 채워짐)
KV_REST_API_URL=https://your-instance-name.upstash.io
KV_REST_API_TOKEN=your-kv-rest-api-token
KV_REST_API_READ_ONLY_TOKEN=your-kv-rest-api-read-only-token
KV_URL=rediss://default:your-password@your-instance-name.upstash.io:6379
REDIS_URL=rediss://default:your-password@your-instance-name.upstash.io:6379

# 방문자 통계 정리 Cron(app/api/cron/cleanup-stats) 인증용 — Vercel이 Cron 트리거 시
# Authorization: Bearer $CRON_SECRET 헤더를 자동으로 붙여준다. 임의의 긴 랜덤 문자열로 채울 것.
CRON_SECRET=your-cron-secret
